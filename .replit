modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/tara-ev: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/mockup-sandbox: Component Preview Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "verify-wording"

[[workflows.workflow]]
name = "verify-removals"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "artifacts/tara-ev/scripts/verify-removals.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "verify-wording"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "artifacts/tara-ev/scripts/verify-wording.sh"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
